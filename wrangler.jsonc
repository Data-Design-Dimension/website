// Cloudflare configuration. The site is a static Astro build deployed
// via Cloudflare Workers with Static Assets (the unified successor to
// the older Cloudflare Pages product). The dashboard "Build & scale
// apps" flow reads this file directly.
//
// Authenticate locally one-time:
//   pnpm dlx wrangler login
// Then deploy:
//   pnpm build && pnpm dlx wrangler deploy
//
// See docs/deploy.md for the dashboard recipe.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dadeda-design",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    // Astro emits a static 404.html; serve it for unknown paths instead
    // of falling back to /index.html (which would mask broken links).
    "not_found_handling": "404-page"
  }
}
