---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import md from '../../docs/early-access-testing.md?raw';

/**
 * Live mirror of docs/early-access-testing.md so non-GitHub users
 * have a URL they can read without an account. Single source of
 * truth (the .md file); rendered server-side via marked at build
 * time.
 */
const html = marked.parse(md, { async: false }) as string;
---

<Base
  title="Early Access Testing — DADEDA"
  description="Guided testing tasks and feedback channels for the v0.1.0-preview early-access round of dadeda.design."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>
  <main class="testing-container">
    <article class="testing-prose" set:html={html}></article>
    <footer class="testing-footer">
      <p><a href="/">← Back to the main site</a></p>
    </footer>
  </main>
</Base>

<style>
  .testing-container {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }
  .testing-prose :global(h1) {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }
  .testing-prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin: var(--space-12) 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .testing-prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin: var(--space-6) 0 var(--space-3);
  }
  .testing-prose :global(p) {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-4);
    max-width: 42rem;
  }
  .testing-prose :global(ol),
  .testing-prose :global(ul) {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-4);
    padding-left: 1.5rem;
    max-width: 42rem;
  }
  .testing-prose :global(li) {
    margin-bottom: var(--space-3);
  }
  .testing-prose :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }
  .testing-prose :global(a) {
    color: var(--color-accent-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .testing-prose :global(a:hover),
  .testing-prose :global(a:focus-visible) {
    text-decoration-thickness: 2px;
  }
  .testing-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-canvas-light);
    padding: 0.05rem 0.35rem;
    border-radius: 0.25rem;
  }
  .testing-prose :global(blockquote) {
    border-left: 3px solid var(--color-accent-blue);
    padding-left: var(--space-4);
    margin: 0 0 var(--space-4);
    color: var(--color-text-secondary);
    font-style: italic;
    line-height: 1.7;
    max-width: 42rem;
  }
  .testing-prose :global(blockquote p) {
    color: inherit;
  }
  .testing-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }
  .testing-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .testing-footer a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
