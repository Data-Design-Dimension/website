---
import Base from '../layouts/Base.astro';
---

<Base>
  <div class="flex items-center justify-center min-h-dvh p-8">
    <div class="text-center max-w-2xl">
      <h1 class="text-5xl font-bold tracking-tight" style="color: var(--color-text-primary)">
        DADEDA
      </h1>
      <p class="mt-4 text-xl" style="color: var(--color-text-secondary)">
        I make intelligent experiences where design and technology blur.
      </p>
      <p class="mt-2 text-sm" style="color: var(--color-text-muted)">
        Site rebuild in progress. Something new is coming.
      </p>
    </div>
  </div>
</Base>
