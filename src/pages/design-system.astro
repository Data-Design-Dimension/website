---
import Base from '../layouts/Base.astro';
import ColorSwatch from '../components/ColorSwatch.svelte';
import { viz, vizCardSafe, vizSeq, vizSeqMulti, vizDiv, vizCyc } from '../lib/tokens';
---

<Base title="Design System — DADEDA">
  <div class="ds-container">
    <header class="ds-header">
      <h1>Design System</h1>
      <p>
        The visual language of dadeda.design. Every choice is deliberate — from the
        <code>#DADEDA</code> canvas color (which IS the brand name, a hex code that
        sounds like "data") to the OKLCH color space that ensures perceptual uniformity
        across brand and data visualization palettes.
      </p>
    </header>

    <details class="ds-section" open>
      <summary><h2>Brand Canvas</h2></summary>
      <p>
        <code>#DADEDA</code> — RGB(218, 222, 218). A sage mist with barely perceptible
        green undertone. 86% lightness, 1% saturation. The foundation everything lives on.
      </p>
      <div class="ds-grid-3">
        <ColorSwatch client:load name="--color-canvas" value="oklch(0.89 0.007 155)" label="#DADEDA — sage mist" />
        <ColorSwatch client:load name="--color-canvas-light" value="oklch(0.95 0.004 155)" label="Light variant" />
        <ColorSwatch client:load name="--color-canvas-dark" value="oklch(0.82 0.010 155)" label="Dark variant" />
      </div>
    </details>

    <details class="ds-section" open>
      <summary><h2>Brand Accents</h2></summary>
      <p>
        Bold colors that pop against the sage canvas. Inspired by Philadelphia industrial
        patina and neon energy.
      </p>
      <div class="ds-grid-3">
        <ColorSwatch client:load name="--color-accent-green" value="oklch(0.75 0.20 145)" label="Neon green — primary accent" />
        <ColorSwatch client:load name="--color-accent-blue" value="oklch(0.55 0.15 250)" label="Blueprint cyan — systems" />
        <ColorSwatch client:load name="--color-accent-hot" value="oklch(0.65 0.25 0)" label="Energy accent" />
      </div>
    </details>

    <details class="ds-section" open>
      <summary><h2>Neutrals</h2></summary>
      <div class="ds-grid-5">
        <ColorSwatch client:load name="--color-surface" value="oklch(0.99 0.002 155)" label="Surface" />
        <ColorSwatch client:load name="--color-text-primary" value="oklch(0.20 0.01 155)" label="Text primary" />
        <ColorSwatch client:load name="--color-text-secondary" value="oklch(0.45 0.01 155)" label="Text secondary" />
        <ColorSwatch client:load name="--color-text-muted" value="oklch(0.65 0.005 155)" label="Text muted" />
        <ColorSwatch client:load name="--color-border" value="oklch(0.80 0.008 155)" label="Border" />
      </div>
    </details>

    <details class="ds-section" open>
      <summary><h2>Data Viz — Categorical</h2></summary>
      <p>
        Okabe-Ito hue identity, re-anchored on a monotonic lightness ladder
        (L 0.32 → 0.92, ≥8 units between adjacent stops) so the palette also
        reads cleanly in grayscale. Stock Okabe-Ito collides at Sky Blue ≈ Orange
        in luminance; this version doesn't. CVD-safe across protan / deutan /
        tritan; chroma is near max sustainable at each (L, H) so the palette
        feels chromatic, not flat.
      </p>
      <div class="ds-grid-8">
        <ColorSwatch client:load name="--viz-1" value="oklch(0.32 0.10 155)" label="Dark sage" />
        <ColorSwatch client:load name="--viz-2" value="oklch(0.42 0.18 250)" label="Blue" />
        <ColorSwatch client:load name="--viz-3" value="oklch(0.52 0.18 40)" label="Vermillion" />
        <ColorSwatch client:load name="--viz-4" value="oklch(0.60 0.13 165)" label="Bluish green" />
        <ColorSwatch client:load name="--viz-5" value="oklch(0.68 0.16 350)" label="Reddish purple" />
        <ColorSwatch client:load name="--viz-6" value="oklch(0.76 0.16 70)" label="Orange" />
        <ColorSwatch client:load name="--viz-7" value="oklch(0.84 0.09 230)" label="Sky blue" />
        <ColorSwatch client:load name="--viz-8" value="oklch(0.92 0.16 95)" label="Yellow" />
      </div>
      <p class="ds-strip-caption">Compact comparison — color above, grayscale below. Each stop should remain visibly distinct in both bars when testing CVD types:</p>
      <div class="ds-strip" aria-hidden="true">
        {viz.map((c) => <span style={`background: ${c};`}></span>)}
      </div>
      <div class="ds-strip is-grayscale" aria-hidden="true">
        {viz.map((c) => <span style={`background: ${c};`}></span>)}
      </div>
    </details>

    <details class="ds-section" open>
      <summary><h2>Data Viz — Card-Safe Categorical</h2></summary>
      <p>
        The site's category accents already carry meaning: <strong>green</strong>
        signals See Work cards (H ≈ 130–170), <strong>amber</strong> signals
        Get to Know cards (H ≈ 50–100). Any chart that renders inside an
        expanded card overlay, on top of the Scrambler background, or near
        category UI must avoid those hue bands so data categories don't
        leak meaning into the surrounding interface (or absorb it).
      </p>
      <p>
        <code>vizCardSafe</code> is a 7-stop monotonic-L palette restricted to
        reds (H 0–40), blues (H 200–280), purples / magentas (H 290–350), and
        low-chroma neutrals.
      </p>
      <div class="ds-grid-8">
        <ColorSwatch client:load name="vizCardSafe[0]" value="oklch(0.30 0.005 155)" label="Near-black" />
        <ColorSwatch client:load name="vizCardSafe[1]" value="oklch(0.42 0.18 250)" label="Blue" />
        <ColorSwatch client:load name="vizCardSafe[2]" value="oklch(0.52 0.18 25)" label="Vermillion" />
        <ColorSwatch client:load name="vizCardSafe[3]" value="oklch(0.62 0.16 350)" label="Reddish purple" />
        <ColorSwatch client:load name="vizCardSafe[4]" value="oklch(0.72 0.13 290)" label="Purple" />
        <ColorSwatch client:load name="vizCardSafe[5]" value="oklch(0.82 0.08 220)" label="Sky blue" />
        <ColorSwatch client:load name="vizCardSafe[6]" value="oklch(0.92 0.10 0)" label="Light coral" />
      </div>
      <p class="ds-strip-caption">Compact comparison — color above, grayscale below:</p>
      <div class="ds-strip" aria-hidden="true">
        {vizCardSafe.map((c) => <span style={`background: ${c};`}></span>)}
      </div>
      <div class="ds-strip is-grayscale" aria-hidden="true">
        {vizCardSafe.map((c) => <span style={`background: ${c};`}></span>)}
      </div>
    </details>

    <details class="ds-section" open>
      <summary><h2>Data Viz — Scales</h2></summary>
      <p>
        Sequential, diverging, and cyclical scales live in
        <code>src/lib/tokens.ts</code> (array-shaped, consumed directly by D3).
        Full swatch UI is on the Phase 8 polish list; the values are listed
        below for reference and copy.
      </p>
      <dl class="ds-rationale">
        <dt>Sequential single-hue (7 stops, light → dark)</dt>
        <dd>
          <div class="scale-row"><code>vizSeq.sage</code><span class="scale-strip">{vizSeq.sage.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <div class="scale-row"><code>vizSeq.blueprint</code><span class="scale-strip">{vizSeq.blueprint.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <div class="scale-row"><code>vizSeq.amber</code><span class="scale-strip">{vizSeq.amber.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <div class="scale-row"><code>vizSeq.brown</code><span class="scale-strip">{vizSeq.brown.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <div class="scale-row"><code>vizSeq.gray</code><span class="scale-strip">{vizSeq.gray.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <p class="scale-note">Default to <code>gray</code> or <code>brown</code> when color would distract from the data.</p>
        </dd>
        <dt>Sequential multi-hue (7 stops)</dt>
        <dd>
          <div class="scale-row"><code>vizSeqMulti.cividis</code><span class="scale-strip">{vizSeqMulti.cividis.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <div class="scale-row"><code>vizSeqMulti.dadeda</code><span class="scale-strip">{vizSeqMulti.dadeda.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <p class="scale-note">
            Default: <code>cividis</code> (CVD-verified; no green hues that confuse protan / deutan). Brand-flavored
            option <code>dadeda</code> passes the L-monotonicity test but requires visual review under deutan /
            protan / tritan simulators before using it in shipped viz; if a simulation flattens or inverts the ramp,
            fall back to <code>cividis</code>.
          </p>
        </dd>
        <dt>Diverging (7 stops, neutral midpoint)</dt>
        <dd>
          <div class="scale-row"><code>vizDiv.brbg</code><span class="scale-strip">{vizDiv.brbg.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <div class="scale-row"><code>vizDiv.rdbu</code><span class="scale-strip">{vizDiv.rdbu.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <div class="scale-row"><code>vizDiv.puor</code><span class="scale-strip">{vizDiv.puor.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <div class="scale-row"><code>vizDiv.gray</code><span class="scale-strip">{vizDiv.gray.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <p class="scale-note">
            <code>brbg</code> is the project's default. <code>gray</code> (warm-cool through light, very low chroma)
            for direction without color attention.
          </p>
        </dd>
        <dt>Cyclical (12 stops, constant L, hue rotation)</dt>
        <dd>
          <div class="scale-row"><code>vizCyc</code><span class="scale-strip">{vizCyc.map((c) => <span style={`background: ${c};`}></span>)}</span></div>
          <p class="scale-note">Use for time-of-day, day-of-year, angles, phase. Never use a sequential ramp for cyclical data.</p>
        </dd>
      </dl>
      <h3 class="ds-subsection-h">Palette governance</h3>
      <ul class="ds-bullets">
        <li>Brand colors (DADEDA sage, neon green, blueprint blue, hot accent)
            stay out of viz <em>except</em> for ≤2–3 categorical brands where
            meaning is unambiguous (Fantasy red + #DADEDA being canonical),
            and only when the resulting set passes deuteranopia simulation.</li>
        <li>Inside cards / on Scrambler bg: use <code>vizCardSafe</code>
            for categorical, <code>vizSeq.blueprint / brown / gray</code> for
            sequential, <code>vizDiv.rdbu / gray</code> for diverging. Avoid
            <code>vizSeq.sage / amber</code>, <code>vizSeqMulti.dadeda</code>,
            <code>vizDiv.brbg / puor</code>, and <code>vizCyc</code> in those
            contexts; their hues collide with See Work green or GTK amber.</li>
        <li>Default to <code>vizSeq.gray</code> or <code>vizSeq.brown</code>
            whenever color would distract: small multiples, secondary charts,
            annotation layers, table-as-chart cells.</li>
        <li>Cyclical data uses <code>vizCyc</code>, never a sequential ramp.
            For cyclical data inside cards, use a brightness-only cycle
            through <code>vizSeq.gray</code> with explicit hour / phase labels.</li>
        <li>D3 scales import from <code>tokens.ts</code>; no inline hex in
            viz code.</li>
      </ul>
    </details>

    <details class="ds-section" open>
      <summary><h2>Typography</h2></summary>
      <div class="ds-type-scale">
        <div style="font-size: 3rem; font-weight: 700; letter-spacing: -0.02em;">DADEDA</div>
        <div style="font-size: 2rem; font-weight: 700;">Heading Level 2</div>
        <div style="font-size: 1.5rem; font-weight: 600;">Heading Level 3</div>
        <div style="font-size: 1.25rem;">Body large — where design and technology blur</div>
        <div style="font-size: 1rem;">Body — I make intelligent experiences using first principles thinking and core tenets, accelerated by AI-first engineering approaches.</div>
        <div style="font-size: 0.875rem; color: var(--color-text-secondary);">Small — metadata, labels, timestamps</div>
        <div style="font-size: 0.875rem; font-family: var(--font-mono);">Mono — code, tokens, technical details</div>
      </div>
    </details>

    <details class="ds-section" open>
      <summary><h2>Spacing</h2></summary>
      <div class="ds-spacing">
        {[1, 2, 3, 4, 6, 8, 12, 16, 24].map((n) => (
          <div class="ds-spacing-row">
            <code>--space-{n}</code>
            <div class="ds-spacing-bar" style={`width: ${n * 0.25}rem;`}></div>
            <span>{n * 0.25}rem</span>
          </div>
        ))}
      </div>
    </details>

    <details class="ds-section" open>
      <summary><h2>AI Interaction Design</h2></summary>
      <p>
        The site is built for two audiences in parallel: humans who arrive at
        a browser, and agents who arrive on behalf of a human or alongside
        one. The principles
        below shape every WebMCP tool, every piece of structured data, and
        every UI affordance that participates in agent flow.
      </p>
      <dl class="ds-rationale">
        <dt>Agent transparency</dt>
        <dd>
          Every agent action is observable and reversible. When a tool runs,
          the targeted control glows (amber → green) and is briefly
          non-interactive so the user can see "an agent is acting on this."
          On completion the glow recedes; nothing happens silently. The
          window.dadeda registry is inspectable from any console.
        </dd>
        <dt>Cognitive amplification, not replacement</dt>
        <dd>
          Agents extend what a user is already doing — surfacing
          information, navigating the site, drafting a share — but the user
          stays the author of intent. Drawing on Bret Victor's direct-
          manipulation tradition and Microsoft's HAX guidelines: the agent
          assists, the human chooses.
        </dd>
        <dt>Taste-conducive interaction</dt>
        <dd>
          The system reflects the user's choices rather than imposing a
          default. The Scrambler arrangement is one valid state of many;
          agents can rearrange it. Privacy preferences are user-controlled.
          When an agent shares the user's profile on their behalf, the user
          decides the message and the type.
        </dd>
        <dt>Privacy-by-design defaults</dt>
        <dd>
          Agents access only what's needed. Privacy preferences default to
          off for analytics and agent storage; on for agent discovery (so
          the site is honest about what it offers, but doesn't write
          anything to the device without consent). Set or read via the
          <code>setPrivacyPreferences</code> tool, with a UI surface as a
          parallel control.
        </dd>
        <dt>Markdown-first content delivery for agents</dt>
        <dd>
          Agents read structured content faster than rendered HTML. The
          site exposes <code>llms.txt</code> at the root, JSON-LD
          (<code>Person</code>, <code>WebSite</code>, <code>Organization</code>)
          in <code>&lt;head&gt;</code>, and a planned <code>.md</code> endpoint
          per content page. The Scrambler card collection is
          agent-queryable via <code>getSiteMap</code> /
          <code>searchCards</code> with full content shape — no scraping.
        </dd>
        <dt>Progressive enhancement</dt>
        <dd>
          The site works without agents. The Scrambler navigates by mouse,
          keyboard, and touch; the Knob has direct human controls; cards
          link normally. Agent capability is additive — bring an agent and
          you get more, but you don't need one.
        </dd>
      </dl>
      <p class="ds-rationale-footer">
        Reference architectures: Anthropic <a href="https://modelcontextprotocol.io/" target="_blank" rel="noopener">MCP</a>,
        Google <a href="https://google.github.io/A2A/" target="_blank" rel="noopener">A2A</a>,
        Microsoft <a href="https://www.microsoft.com/en-us/haxtoolkit/" target="_blank" rel="noopener">HAX guidelines</a>,
        and Anthropic's <a href="https://www.anthropic.com/research/constitutional-ai-harmlessness-from-ai-feedback" target="_blank" rel="noopener">Constitutional AI</a>
        principles for transparency. Accessibility calibration via
        <a href="https://www.frank.computer/" target="_blank" rel="noopener">frank.computer / Chartability</a>.
      </p>
    </details>

    <details class="ds-section" open>
      <summary><h2>Why These Choices</h2></summary>
      <dl class="ds-rationale">
        <dt>Why OKLCH?</dt>
        <dd>Perceptually uniform — equal numeric changes produce equal visual changes. Critical for data viz palettes where lightness differences encode meaning.</dd>
        <dt>Why #DADEDA?</dt>
        <dd>The brand IS the color. dadeda.design, the hex code, the sage mist canvas. One identity.</dd>
        <dt>Why Tailwind + vanilla CSS?</dt>
        <dd>Tailwind for layout and structural utility. Vanilla CSS for animation, D3 viz, and the Scrambler 3D transforms where programmatic control matters. Each tool where it's strongest.</dd>
        <dt>Why no shadow DOM?</dt>
        <dd>D3.js needs direct DOM access for <code>d3.select()</code>. Svelte compiles to direct DOM operations — no encapsulation barrier, no workarounds needed.</dd>
      </dl>
    </details>
  </div>
</Base>

<style>
  .ds-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }
  .ds-header {
    margin-bottom: var(--space-16);
  }
  .ds-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  .ds-header p {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 40rem;
    line-height: 1.7;
  }
  .ds-section {
    margin-bottom: var(--space-16);
  }
  .ds-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .ds-section p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    max-width: 40rem;
  }
  .ds-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .ds-grid-5 {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
  }
  .ds-grid-8 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .ds-type-scale {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .ds-spacing {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ds-spacing-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: 0.875rem;
  }
  .ds-spacing-row code {
    width: 8rem;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }
  .ds-spacing-bar {
    height: 1rem;
    background: var(--color-accent-green);
    border-radius: 0.25rem;
    min-width: 0.25rem;
  }
  .ds-spacing-row span {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
  .ds-rationale dt {
    font-weight: 600;
    margin-top: var(--space-4);
  }
  .ds-rationale dd {
    color: var(--color-text-secondary);
    margin-left: 0;
    max-width: 48rem;
    line-height: 1.6;
  }
  .ds-rationale-footer {
    margin-top: var(--space-6);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 48rem;
  }
  .ds-rationale-footer a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ds-subsection-h {
    font-size: 1rem;
    font-weight: 600;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--color-text-primary);
  }
  .ds-bullets {
    color: var(--color-text-secondary);
    max-width: 48rem;
    padding-left: var(--space-6);
    margin: 0;
  }
  .ds-bullets li {
    margin-bottom: var(--space-3);
    line-height: 1.6;
  }
  .ds-bullets code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--color-canvas-light);
    padding: 0.05rem 0.3rem;
    border-radius: 0.2rem;
  }
  .ds-strip-caption {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .ds-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 2px;
    height: 2.5rem;
    border-radius: 0.375rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .ds-strip span {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ds-strip.is-grayscale {
    filter: grayscale(1);
  }
  .ds-strip + .ds-strip {
    margin-top: 4px;
  }
  .scale-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-2) 0;
  }
  .scale-row code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .scale-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 1px;
    height: 1.6rem;
    border-radius: 0.25rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .scale-strip > span {
    display: block;
  }
  .scale-note {
    grid-column: 1 / -1;
    margin: var(--space-3) 0 var(--space-4);
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    line-height: 1.55;
  }
  .scale-note code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: var(--color-canvas-light);
    padding: 0.05rem 0.3rem;
    border-radius: 0.2rem;
  }
  @media (max-width: 768px) {
    .scale-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
  /* Collapsible section affordance using native <details>. The <summary>
   * holds the section h2 and gets a hover/focus indicator + a chevron
   * marker that rotates open / closed. */
  details.ds-section > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  details.ds-section > summary::-webkit-details-marker {
    display: none;
  }
  details.ds-section > summary::before {
    content: '▸';
    color: var(--color-text-muted);
    font-size: 0.85em;
    transition: transform var(--duration-fast) ease;
    display: inline-block;
  }
  details.ds-section[open] > summary::before {
    transform: rotate(90deg);
  }
  details.ds-section > summary > h2 {
    margin: 0;
    border-bottom: none;
    padding-bottom: 0;
  }
  details.ds-section > summary:hover {
    color: var(--color-text-primary);
  }
